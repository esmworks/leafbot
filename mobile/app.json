{
  "expo": {
    "name": "Leaf Bot",
    "slug": "leafbot",
    "scheme": "leafbot",
    "version": "0.10.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/AppIcon.icon",
      "bundleIdentifier": "com.esmworks.leafbot",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.esmworks.leafbot",
      "adaptiveIcon": {
        "backgroundColor": "#1F4330",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.WRITE_CALENDAR",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      ["expo-screen-orientation", { "initialOrientation": "PORTRAIT_UP" }],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FAFAFA",
          "dark": {
            "backgroundColor": "#070707"
          }
        }
      ],
      "expo-web-browser",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Leaf Bot opens your photos so you can attach them to a message.",
          "cameraPermission": "Leaf Bot uses the camera to scan a connect code and to take a photo to attach to a message.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Leaf Bot uses the camera to scan a connect code and to take a photo to attach to a message.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Leaf Bot uses the camera to scan a connect code and to take a photo to attach to a message.",
          "microphonePermission": "Leaf Bot does not record sound."
        }
      ],
      "expo-sharing",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Leaf Bot lets the bots you allow read your calendar, when you ask them to.",
          "remindersPermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Leaf Bot lets the bots you allow search your contacts, when you ask them to."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Leaf Bot lets the bots you allow see where you are, when you ask them to.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.esmworks.leafbot.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.esmworks.leafbot",
          "enablePushNotifications": true,
          "frequentUpdates": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
