<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Notarization requires the hardened runtime, which by default forbids what the app does every day:
  V8 and the bundled Claude CLI compile code at run time (JIT), and the server loads native modules
  from its own node_modules. These exceptions keep that working; the app and every binary in it is
  still signed with the same Developer ID.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!--
      Kept although every binary in the app is signed with the same Developer ID: the same file is
      given to the binaries inside (entitlementsInherit), and the bundled Claude CLI is a single-file
      program that carries native add-ons (audio capture, clipboard), writes them to a temporary file
      and loads them from there, where no signature of ours covers them. A build without a
      certificate is signed ad hoc, which has no team for library validation to match at all. The
      ways to inject code into a running app (NODE_OPTIONS, the inspector) are closed by the fuses in
      electron-builder.yml instead.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Speaking a message instead of typing it; macOS still asks the person first. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!--
      The hardened runtime blocks reading Calendar, Reminders (both through the calendars
      entitlement) and Contacts unless these are present, whatever the usage descriptions say. The
      commands a bot runs inherit them; macOS still asks the person first.
    -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
  </dict>
</plist>
