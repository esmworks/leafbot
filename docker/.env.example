# Long random values: openssl rand -hex 32
# The database password goes into DATABASE_URL as is, so it must not contain / + @ : or %.
POSTGRES_PASSWORD=
LEAFBOT_ACCESS_KEY=
# Shared secret between the server and the computer service (min 32 chars): openssl rand -hex 32
LEAFBOT_COMPUTER_TOKEN=
# Public host name when behind a reverse proxy, e.g. leafbot.example.com
LEAFBOT_ALLOWED_HOSTS=
# Full public address, e.g. https://leafbot.example.com: used in routine webhook addresses and
# sign-in callbacks, and its host is accepted like LEAFBOT_ALLOWED_HOSTS
LEAFBOT_PUBLIC_URL=
# 1 when served over HTTPS
LEAFBOT_SECURE_COOKIES=0
# Secret the reverse proxy sends in the X-Leafbot-Proxy header, so the server may trust the
# X-Forwarded-For address it adds; without it every sign-in attempt counts as the proxy's address.
# openssl rand -hex 32
LEAFBOT_PROXY_SECRET=
LEAFBOT_PORT=4319
# AppArmor profile for the containers; `sudo ./docker/apparmor.sh --env docker/.env` picks it for this host
# (leafbot-userns on Ubuntu 23.10+), see docker/README.md
# LEAFBOT_APPARMOR=leafbot-userns
# Name of the bridge the containers reach the internet through (at most 15 characters). Change it only when
# another installation on this host already uses leafbot0, and run docker/firewall.sh with BRIDGE=<the same name>
# LEAFBOT_BRIDGE=leafbot0
# Hosting panels such as Dokploy: start the gateway service and point the panel's domain at it (port 4319), not at
# leafbot; see "Dokploy ve benzeri paneller" in docker/README.md
# COMPOSE_PROFILES=gateway
# Web search for bots on API keys: the address of a SearXNG with JSON output turned on (search.formats: json).
# The leafbot container must share a Docker network with it; see "Web araması" in docker/README.md
# WEB_SEARCH_URL=http://searxng:8080
# Model services of your own outside this installation (Whisper, Kokoro, Ollama, SearXNG): an existing Docker network
# they also join, so the server reaches them by name without joining the panel's shared network; see
# "Kendi model servisleriniz" in docker/README.md
# LEAFBOT_SERVICES_NETWORK=leafbot-services
# Optional remote access without opening a port; see "Uzaktan erişim" in docker/README.md.
# Cloudflare Tunnel (docker compose --profile cloudflare ...): the tunnel's token from the Cloudflare dashboard
# CLOUDFLARE_TUNNEL_TOKEN=
# Tailscale (docker compose --profile tailscale ...): an auth key from the Tailscale admin console
# TAILSCALE_AUTHKEY=
# TAILSCALE_HOSTNAME=leafbot
# The bots' browsers leave through Cloudflare WARP instead of this host's address, which some sites refuse for being
# a data centre's; see "Tarayıcının çıkış adresi" in docker/README.md. Start the warp service (--profile warp, or
# LEAFBOT_WARP=1 with docker/install.sh) and point the browsers at it:
# LEAFBOT_WARP=1
# LEAFBOT_EGRESS_PROXY=socks5://leafbot-warp:1080

# Only for compose.vps.yml (ready-made images behind Caddy). docker/install.sh writes these itself; set them
# by hand only when running that file without the installer:
#   docker compose -f docker/compose.yml -f docker/compose.vps.yml --env-file docker/.env up -d
# Image tag to pull, the release without its leading v, e.g. 1.4.0; it must match the compose files next to it
# LEAFBOT_VERSION=
# Domain Caddy serves and fetches the HTTPS certificate for, e.g. leafbot.example.com; set LEAFBOT_PUBLIC_URL
# to https://<domain>, LEAFBOT_ALLOWED_HOSTS to <domain> and LEAFBOT_SECURE_COOKIES=1 with it
# LEAFBOT_DOMAIN=
# The bots' desktops: off unless set. To turn them on, set LEAFBOT_COMPUTER=1 and
# LEAFBOT_COMPUTER_URL=http://computer-api:4320 and add --profile computer to the command above
# (the computer service needs about 6 GB of memory of its own)
# LEAFBOT_COMPUTER=0
# LEAFBOT_COMPUTER_URL=
# Language of the installer's messages (tr or en); only the installer reads it
# LEAFBOT_INSTALL_LANG=en
